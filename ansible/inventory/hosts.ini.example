# Real hosts.ini is auto-generated by `terraform apply` (terraform/inventory.tf)
# and is gitignored. This example is only for reference / for running
# against Vagrant or manually-provisioned boxes.

[fleet]
node-0 ansible_host=192.0.2.10 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-ec2-keypair.pem
node-1 ansible_host=192.0.2.11 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-ec2-keypair.pem
node-2 ansible_host=192.0.2.12 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-ec2-keypair.pem

[monitoring]
node-0 ansible_host=192.0.2.10 ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/my-ec2-keypair.pem

[fleet:vars]
ansible_python_interpreter=/usr/bin/python3
