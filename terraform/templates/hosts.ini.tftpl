# Auto-generated by `terraform apply` (see terraform/inventory.tf).
# Do not edit by hand - it will be overwritten on the next apply.

[fleet]
%{ for idx, ip in fleet_ips ~}
node-${idx} ansible_host=${ip} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/${ssh_key_name}.pem
%{ endfor ~}

[monitoring]
node-${monitoring_index} ansible_host=${fleet_ips[monitoring_index]} ansible_user=ubuntu ansible_ssh_private_key_file=~/.ssh/${ssh_key_name}.pem

[fleet:vars]
ansible_python_interpreter=/usr/bin/python3
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
