# Copy to terraform.tfvars and fill in your own values.
# terraform.tfvars is gitignored - never commit it.

aws_region   = "eu-north-1"
fleet_size   = 3
instance_type = "t3.micro"
project_name = "mini-compute-fleet"

# Restrict this to YOUR IP, e.g. "203.0.113.4/32". Never use 0.0.0.0/0.
admin_cidr = "203.0.113.4/32"

# Must already exist in the target AWS region (aws ec2 create-key-pair ...)
ssh_key_name = "my-ec2-keypair"
